{
    "name": "componenta/cqrs-lock",
    "description": "Resource lock middleware for Componenta CQRS commands",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "componenta/config": "^2.0.2",
        "componenta/cqrs": "^2.0 || ^3.0.3 || ^4.0",
        "psr/container": "^2.0",
        "symfony/lock": "^7.4 || ^8.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\CQRS\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\CQRS\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "extra": {
        "branch-alias": {
            "dev-main": "3.0.x-dev"
        },
        "componenta": {
            "config-providers": [
                "Componenta\\CQRS\\Lock\\ConfigProvider"
            ]
        }
    },
    "prefer-stable": true,
    "scripts": {
        "test": "@php vendor/bin/pest",
        "analyse": "@php vendor/bin/phpstan analyse src --level=max"
    }
}
